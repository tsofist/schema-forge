{
  "name": "@tsofist/schema-forge",
  "version": "5.9.2",
  "description": "Generate JSON schema from TypeScript types",
  "author": "Andrew Berdnikov <tsofistgudmen@gmail.com>",
  "license": "LGPL-3.0",
  "main": "lib/types",
  "types": "lib/types",
  "type": "commonjs",
  "scripts": {
    "build": "rm -rf lib/** && tsc -p tsconfig.build.json",
    "format": "npm run lint -- --fix",
    "lint": "eslint . --cache --cache-location .cache/",
    "pkg:publish": "semantic-release --no-ci",
    "pkg:publish-test": "semantic-release --dry-run",
    "pkg:purge": "rm -rf lib .coverage .lint-cache .cache node_modules",
    "prepare": "husky && (cp node_modules/@tsofist/web-buddy/.editorconfig \"$INIT_CWD\" || true)",
    "test": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@tsofist/stem": "^8.3.3",
    "@ungap/structured-clone": "^1.4.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "json-schema": "^0.4.0",
    "json-schema-faker": "~0.5.9",
    "jsonpath-plus": "^10.4.0",
    "ts-json-schema-generator": "~2.3.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@tsofist/web-buddy": "^2.0.0-next.16",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "@types/ungap__structured-clone": "^1.2.0",
    "jest": "~30.5.1",
    "supertest": "^7.2.2",
    "ts-jest": "~29.4.12",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {},
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "release": {
    "extends": [
      "@tsofist/web-buddy/lib/semantic-release/config.github.js"
    ]
  },
  "jest": {
    "cacheDirectory": ".cache",
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": ".coverage",
    "coveragePathIgnorePatterns": [
      "types.ts"
    ],
    "moduleDirectories": [
      "node_modules"
    ],
    "moduleNameMapper": {},
    "prettierPath": null,
    "roots": [
      "src",
      "test-sources"
    ],
    "setupFiles": [],
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "testTimeout": 10000,
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.build-test.json",
          "useESM": true
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules"
    ]
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "!*.private.*",
    "!*.tmp.*"
  ],
  "keywords": [
    "tsofist",
    "json-schema",
    "json-schema generator"
  ]
}
